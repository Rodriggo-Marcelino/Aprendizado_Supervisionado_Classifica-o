#Quantidade de valores nulos em cada variavel 
dataset.isnull().sum()


#Para excluir valores missing
dataset2 = dataset.dropna()


dataset2.shape


dataset2.isnull().sum()


#caso apresente valores null, podemos substituir pela media das variaveis 
dataset2['Age'] = dataset2['Age'].fillna(dataset2['Age'].mean())





dataset.describe()


dataset.mode()








#Estamos usando o loc para adicionar apenas os valores diferentes de zero
#passamos o dataset inteiro porem, apenas armazenamos os valores diferentes de zero
dataset2 = dataset.loc[dataset.RestingBP != 0]


dataset.shape


dataset2.shape


dataset2.describe()





dataset2.Cholesterol.value_counts()


dataset2.Cholesterol.mean()


dataset2['Cholesterol'] = dataset2['Cholesterol'].replace(0, np.nan)


dataset2.isnull().sum()


dataset2.Cholesterol.mean()


#substituir valores missing pela media 
dataset2.Cholesterol.fillna(dataset2.Cholesterol.mean(), inplace = True)


dataset.isnull().sum()


dataset2.describe()


dataset2.mode()


sns.histplot(dataset2, x='Cholesterol', bins = 30, color = 'orange', kde = True, stat = 'count')





px.box(dataset2, y = 'Age')


px.box(dataset2, y = 'RestingBP')


px.box(dataset2, y = 'Cholesterol')


px.box(dataset2, y = 'MaxHR')





dataset2.to_csv('heart_tratado.csv', sep=';', encoding='utf-8', index = False)
